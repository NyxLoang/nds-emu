# 构建产物
build/
build-prof/
build-prof2/
# 其它对照构建（-march=native / PGO 等）：同样不入库
build-*/

# Python 辅助脚本的字节码缓存（tools/*.py）
__pycache__/

# 真实卡带 ROM：体积大且受版权保护，不进入版本库（测试用假 ROM 见 homebrew/）
tools/*.nds
tools/*.sav
# homebrew 假 ROM 跑出来的存档芯片镜像同样是生成物
homebrew/*.sav
# 剖析产物（gprof 数据文件等）
gmon.out

# 历史遗留：早期中断安装时下载的 CMake 便携包（工具链已由 WinLibs 提供）
tools/cmake.zip

# 无头运行默认写到当前目录的截图/图像产物（诊断用，不入库）
headless_shot*.bmp
/*.bmp

# --dump 在产品（前缀为空时会落到工作区根目录，形如 `_mainram.bin`）
/*_mainram.bin
/*_vram.bin
/*_itcm.bin
/*_dtcm.bin
/*_palette.bin
/*_oam.bin
/*_arm7wram.bin
/*_sharedwram.bin
/*_io9.bin
/*_io7.bin
