@@ -34,6 +34,13 @@ namespace melonDS
 using Platform::Log;
 using Platform::LogLevel;
 
+/* 21-B9yi(续108p) 诊断：PC 直方图（`REF_PCHOT=1` 时每条解释指令累加一次），
+   分桶与本模拟器 `NDS_PCHOT=1` 的 hot9/hot7 完全一致（桶 = (pc>>4)&0xFFFF）。
+   用途：直接回答「参考核这段时间在跑哪些代码、本地在跑哪些」，从而定位
+   「同一段游戏进度，为什么参考核要多跑 1.7 倍指令」。 */
+extern unsigned long long RefPcHist[2][1 << 16];
+extern int RefPcHistOn;
+
 #ifdef GDBSTUB_ENABLED
 void ARM::GdbCheckA()
 {
@@ -158,6 +165,8 @@ void ARM::Reset()
 {
     Cycles = 0;
     Halted = 0;
+    InstrCount = 0;   /* 21-B9yi(续108e) 诊断计数器 */
+    BiosInstrCount = 0;
 
     IRQ = 0;
 
@@ -616,6 +625,10 @@ void ARMv5::Execute()
 
     while (NDS.ARM9Timestamp < NDS.ARM9Target)
     {
+        InstrCount++;   /* 21-B9yi(续108e) 诊断：每条解释指令记一次 */
+        if (RefPcHistOn) RefPcHist[0][(R[15] >> 4) & 0xFFFF]++;
+        if (R[15] >= 0xFFFF0000u && R[15] < 0xFFFF4000u)
+            BiosInstrCount++;   /* 21-B9yi(续108h)：执行在 ARM9 BIOS 区 */
 #ifdef JIT_ENABLED
         if constexpr (mode == CPUExecuteMode::JIT)
         {
@@ -756,6 +769,10 @@ void ARMv4::Execute()
 
     while (NDS.ARM7Timestamp < NDS.ARM7Target)
     {
+        InstrCount++;   /* 21-B9yi(续108e) 诊断：每条解释指令记一次 */
+        if (RefPcHistOn) RefPcHist[1][(R[15] >> 4) & 0xFFFF]++;
+        if (R[15] < 0x4000u)
+            BiosInstrCount++;   /* 21-B9yi(续108h)：执行在 ARM7 BIOS 区 */
 #ifdef JIT_ENABLED
