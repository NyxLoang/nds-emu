 namespace melonDS
 {
+
+/* 21-B9yi(续108j) 诊断：`REF_CARTLOG=1` → 把卡带**传输级**事件按帧打出来
+   （START: 命令+长度；END: 已传位置/长度）。字段与本地 `NDS_CARTLOG2` 的
+   `cartlog2:` 行对齐，用于比较「谁在什么时候作废/重排一次传输」。 */
+extern int RefDbgFrame;
+static int RefCartLogOn()
+{
+    static int on = -1;
+    if (on < 0)
+        on = (std::getenv("REF_CARTLOG") != nullptr) ? 1 : 0;
+    return on;
+}
 using Platform::Log;
 using Platform::LogLevel;
 
